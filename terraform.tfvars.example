region = "us-east-1"

# Discovery filters (optional)
filter_provider        = "Amazon"
filter_output_modality = "TEXT"

# Model to instantiate
model_id = "amazon.nova-pro-v1:0"
name     = "my-app-nova-pro"

# For newer Claude models, set both of these instead:
# model_id                    = "anthropic.claude-sonnet-4-5-20250929-v1:0"
# system_inference_profile_id = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"

tags = {
  project = "my-app"
  env     = "dev"
}

# Provisioned throughput — expensive, leave false unless you mean it
enable_provisioned_throughput = false
